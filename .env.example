# LLM provider: "anthropic" or "azure". For azure, MODEL_* are your deployment names
# (e.g. a gpt-4o-mini deployment).
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://ai-web-scraper-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-14
MODEL_EXTRACT=gpt-4.1-nano
MODEL_JUDGE=gpt-4.1-nano
MODEL_ESCALATE=gpt-4.1-nano  # anthropic: claude-haiku-5-5 / claude-sonnet-5-5
DATABASE_URL=postgresql+asyncpg://scraper:scraper@localhost:5433/scraper
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=scraper-html
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MAX_PAGES_TOTAL=50
MAX_RETRIES=2
MAX_TOKENS_PER_RUN=200000
MIN_QUALITY=0.75
PLAN_CAP_PRODUCTS=500

# API: set a token to require "Authorization: Bearer <token>" (leave empty only on localhost)
API_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]
# Worker
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
